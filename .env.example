# ──────────────────────────────────────
# API Keys for Memory Providers
# ──────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Only adapters with valid keys will connect; others will gracefully degrade.

# ── LLM ───────────────────────────────
# The default answer model and the judge are OpenAI, so set OPENAI_API_KEY.
# To use another provider, set its key and pass --answer-model / --judge-model
# as provider/model (see docs/LONGMEMEVAL_S.md). The default judge is
# openai/gpt-4o; any other judge makes the score non-comparable to upstream.
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── mem0 ──────────────────────────────
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# ── Zep ───────────────────────────────
ZEP_API_KEY=

# ── Supermemory ───────────────────────
SUPERMEMORY_API_KEY=


# ── Synap ────────────────────────────
SYNAP_API_KEY=
SYNAP_INSTANCE_ID=
# Optional. Defaults to https://synap-cloud-prod.maximem.ai when empty.
SYNAP_BASE_URL=
SYNAP_GRPC_HOST=
