# ──────────────────────────────────────
# API Keys for Memory Providers
# ──────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# Only adapters with valid keys will connect; others will gracefully degrade.

# ── OpenAI (shared LLM) ──────────────
OPENAI_API_KEY=sk-your-openai-key

# ── mem0 ──────────────────────────────
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# ── Zep ───────────────────────────────
ZEP_API_KEY=

# ── Supermemory ───────────────────────
SUPERMEMORY_API_KEY=


# ── Synap ────────────────────────────
SYNAP_API_KEY=
SYNAP_BASE_URL=
SYNAP_INSTANCE_ID=
SYNAP_BOOTSTRAP_TOKEN=
SYNAP_CLIENT_ID=
SYNAP_GRPC_HOST=
